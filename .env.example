# Dev mode: local storage + sync tasks, no Docker needed (database is always MySQL)
DEV_MODE=true
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/ai_tutor
LOCAL_STORAGE_DIR=./uploads

# JWT
SECRET_KEY=dev-secret-key-change-in-production

# AI / LLM（文本类调用默认走 DeepSeek）
LLM_API_KEY=your-deepseek-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 视觉/多模态专用（作业识别等；DeepSeek 不支持视觉，使用 Qwen 多模态）
VISION_API_KEY=your-qwen-api-key
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.7-plus

# 讯飞语音评测（流式版 ISE，普通话测评用）
XFYUN_APP_ID=your-app-id
XFYUN_API_KEY=your-api-key
XFYUN_API_SECRET=your-api-secret

# ── Production (Docker) settings below ──
# DEV_MODE=false
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/dbname
# REDIS_URL=redis://localhost:6379/0
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
